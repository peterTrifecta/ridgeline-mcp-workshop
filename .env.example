# Anthropic API key (console.anthropic.com), not a Claude Code login.
ANTHROPIC_API_KEY=

# Model used by the chat page. Any current model id works.
RIDGELINE_MODEL=claude-sonnet-5-5

# Thinking effort: low keeps the demo snappy on stage.
RIDGELINE_EFFORT=low

# Port for the local chat page.
RIDGELINE_PORT=8765
